# ==============================================================================
# Antigravity Telegram Agent v4.0 — Environment Configuration Template
# Copy this file to .env (`cp .env.example .env`) or run `python setup_wizard.py`
# ==============================================================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Primary Administrator Telegram User ID
# Leave empty to automatically claim Admin role on the first `/start` message,
# or run `python setup_wizard.py` for automatic live detection!
ALLOWED_USER_ID=

# Optional: Custom path to Antigravity CLI binary (`agy` / `agy.exe`)
# Leave empty for automatic cross-platform detection.
AGY_BIN_PATH=

# Optional: Default Agent Workspace Directory
WORKSPACE_DIR=
